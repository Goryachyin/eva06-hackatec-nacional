{
  "name": "salud-digna-omnicanal-backend",
  "version": "1.0.0",
  "description": "Cerebro Orquestador Omnicanal - Reto Salud Digna x HackaTec 2026",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "prisma:push": "dotenv -e ../.env -- prisma db push",
    "prisma:seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "test:reliability": "dotenv -e ../.env -- tsx src/scripts/testReliability.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.49.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.2",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
