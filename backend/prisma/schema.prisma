// ============================================================================
// Reto Salud Digna x TecNM HackaTec Nacional — Beta v2
// Orquestacion Omnicanal de Atencion: Un paciente, una sola conversacion
//
// Nucleo Relacional: PostgreSQL 16 + Prisma ORM
// Arquitectura Multibeneficiario (Titular != Paciente Beneficiario):
//   - Un mismo telefono/cuenta (Titular) puede gestionar citas para familiares
//     o conocidos preservando expedientes clinicos separados por CURP.
//   - Retos Step-Up OTP (TTL 300s) e idempotencia de mensajes (SETNX TTL 24h)
//     viven en Redis 7.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS CANONICOS
// ============================================================================

enum IdentifierType {
  WEB_SESSION
  PHONE
  EMAIL
  CURP
  APP
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
  NO_ESPECIFICADO
}

enum RelationshipType {
  SELF
  HIJO_A
  PADRE_MADRE
  CONYUGE
  ABUELO_A
  FAMILIAR
  CONOCIDO
}

enum Channel {
  WEB
  WHATSAPP
  CALL_CENTER
  APP
  SYSTEM
}

enum CaseState {
  INICIADO
  COTIZANDO
  CLINICA_ELEGIDA
  PAUSADO_PENDIENTE
  EN_PROGRESO
  DUDAS_ABIERTAS
  EN_ATENCION_ASESOR
  CITA_CONFIRMADA
}

enum ActorRole {
  PATIENT
  BOT
  ADVISOR
  ADMIN
  SYSTEM
}

enum EventType {
  SESSION_STARTED
  STUDY_QUOTED
  CLINIC_SELECTED
  IDENTITY_LINKED
  FLOW_INTERRUPTED
  CHANNEL_SWITCH_DETECTED
  OTP_CHALLENGE_SENT
  OTP_VALIDATION_FAILED
  IDENTITY_VERIFIED_OTP
  CONTEXT_REHYDRATED
  PATIENT_QUESTION_LOGGED
  ADVISOR_ASSIGNED
  APPOINTMENT_CONFIRMED
}

enum StaffRole {
  ASESOR
  ADMIN
}

// ============================================================================
// MODELOS RELACIONALES (POSTGRESQL 16)
// ============================================================================

/// Expediente clinico individual (9 campos oficiales Salud Digna + cuenta opcional).
/// phone NO es unico para permitir que familiares/conocidos compartan numero de contacto
/// mientras cada paciente mantiene su propia CURP y expediente clinico separado.
model Patient {
  id               String    @id @default(uuid()) @db.Uuid
  firstName        String?   @map("nombres") @db.VarChar(120)
  paternalLastName String?   @map("apellido_paterno") @db.VarChar(100)
  maternalLastName String?   @map("apellido_materno") @db.VarChar(100)
  birthDate        DateTime? @map("fecha_nacimiento") @db.Date
  gender           Gender?   @map("genero")
  birthState       String?   @map("estado_nacimiento") @db.VarChar(80)
  country          String    @default("México") @map("pais") @db.VarChar(80)
  curp             String?   @unique @map("curp") @db.VarChar(18)
  phone            String?   @map("telefono") @db.VarChar(20)
  email            String?   @unique @map("email") @db.VarChar(180)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  identityLinks         IdentityLink[]
  serviceCases          ServiceCase[]         @relation("BeneficiaryCases")
  requestedCases        ServiceCase[]         @relation("RequesterCases")
  journeyEvents         JourneyEvent[]
  managedBeneficiaries  PatientRelationship[] @relation("HolderRelationships")
  managedByHolders      PatientRelationship[] @relation("BeneficiaryRelationships")

  @@index([phone], name: "idx_patients_phone")
  @@index([paternalLastName, maternalLastName, firstName], name: "idx_patients_full_name")
  @@map("patients")
}

/// Relacion autorizada Titular -> Beneficiario (familiar/conocido) con consentimiento auditado
model PatientRelationship {
  id                   String           @id @default(uuid()) @db.Uuid
  holderPatientId      String           @map("holder_patient_id") @db.Uuid
  beneficiaryPatientId String           @map("beneficiary_patient_id") @db.Uuid
  relationship         RelationshipType @default(FAMILIAR)
  consentAccepted      Boolean          @default(true) @map("consent_accepted")
  consentAcceptedAt    DateTime         @default(now()) @map("consent_accepted_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  holder      Patient @relation("HolderRelationships", fields: [holderPatientId], references: [id], onDelete: Cascade)
  beneficiary Patient @relation("BeneficiaryRelationships", fields: [beneficiaryPatientId], references: [id], onDelete: Cascade)

  @@unique([holderPatientId, beneficiaryPatientId], name: "uq_holder_beneficiary")
  @@index([holderPatientId], name: "idx_relationships_holder")
  @@map("patient_relationships")
}

/// Vinculacion multicanal (Identity Resolution + proteccion PII en monitoreo)
model IdentityLink {
  id               String         @id @default(uuid()) @db.Uuid
  patientId        String         @map("patient_id") @db.Uuid
  identifierType   IdentifierType @map("identifier_type")
  identifierHash   String         @map("identifier_hash") @db.VarChar(128)
  identifierMasked String         @map("identifier_masked") @db.VarChar(120)
  verified         Boolean        @default(false)
  verifiedAt       DateTime?      @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([identifierType, identifierHash], name: "uq_identity_type_hash")
  @@index([patientId], name: "idx_identity_links_patient")
  @@map("identity_links")
}

/// Tramite vivo: separa Beneficiario (patientId) de Titular solicitante (requesterPatientId)
model ServiceCase {
  id                 String    @id @default(uuid()) @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  requesterPatientId String?   @map("requester_patient_id") @db.Uuid
  relationshipLabel  String?   @map("relationship_label") @db.VarChar(40)
  thirdPartyConsent  Boolean   @default(false) @map("third_party_consent")
  journeyId          String    @unique @default(uuid()) @map("journey_id") @db.Uuid
  caseType           String    @default("CITA_ESTUDIO") @map("case_type") @db.VarChar(60)
  currentState       CaseState @default(INICIADO) @map("current_state")
  currentChannel     Channel   @map("current_channel")
  contextJson        Json      @default("{}") @map("context_json") @db.JsonB
  version            Int       @default(1)
  assignedAdvisorId  String?   @map("assigned_advisor_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient         Patient        @relation("BeneficiaryCases", fields: [patientId], references: [id], onDelete: Cascade)
  requester       Patient?       @relation("RequesterCases", fields: [requesterPatientId], references: [id], onDelete: SetNull)
  assignedAdvisor StaffUser?     @relation("AdvisorAssignedCases", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  journeyEvents   JourneyEvent[]

  @@index([patientId, currentState], name: "idx_cases_patient_state")
  @@index([requesterPatientId, currentState], name: "idx_cases_requester_state")
  @@index([currentState, updatedAt], name: "idx_cases_state_updated")
  @@index([assignedAdvisorId], name: "idx_cases_advisor")
  @@map("service_cases")
}

/// Audit Trail cronologico e inmutable (Trazabilidad E2E con correlation_id)
model JourneyEvent {
  id            String     @id @default(uuid()) @db.Uuid
  caseId        String     @map("case_id") @db.Uuid
  patientId     String     @map("patient_id") @db.Uuid
  journeyId     String     @map("journey_id") @db.Uuid
  correlationId String     @map("correlation_id") @db.Uuid
  channel       Channel
  actorRole     ActorRole  @map("actor_role")
  eventType     EventType  @map("event_type")
  prevState     CaseState? @map("prev_state")
  nextState     CaseState? @map("next_state")
  payloadJson   Json       @default("{}") @map("payload_json") @db.JsonB
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  serviceCase ServiceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt], name: "idx_events_case_time")
  @@index([patientId, createdAt], name: "idx_events_patient_time")
  @@index([journeyId, createdAt], name: "idx_events_journey_time")
  @@index([correlationId], name: "idx_events_correlation")
  @@index([eventType, createdAt], name: "idx_events_type_time")
  @@map("journey_events")
}

/// Usuarios operativos del sistema con control de acceso RBAC
model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(180)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         StaffRole
  fullName     String    @map("full_name") @db.VarChar(180)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  assignedCases ServiceCase[] @relation("AdvisorAssignedCases")

  @@map("users_staff")
}
